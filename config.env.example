# Copia este archivo a config.env y llena los valores.
#   cp config.env.example config.env

# PostgreSQL (backend store)
PG_USER=mlflow
PG_PASSWORD=cambia_esta_password
PG_DATABASE=mlflow
PG_PORT=5432

# MLflow
# En macOS el puerto 5000 lo ocupa el receptor AirPlay, por eso 5001
MLFLOW_PORT=5001
MLFLOW_BUCKET_NAME=mlflow

# MinIO: credenciales de administrador (para entrar a la consola web)
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=cambia_esta_password
MINIO_ADDRESS=:9000
MINIO_CONSOLE_ADDRESS=:9001
MINIO_STORAGE_USE_HTTPS=False
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO: access keys que usará MLflow.
# Se generan en la consola web (http://localhost:9001) una vez que el stack está
# arriba, entrando con MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
MINIO_ACCESS_KEY=
MINIO_SECRET_ACCESS_KEY=
